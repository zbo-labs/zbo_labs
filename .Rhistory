library(easypackages)
libraries(
c(
"ggplot2",
"tidyverse",
"tidyr",
"ggpubr",
"janitor",
"gghalves",
"knitr",
"kableExtra",
"flextable",
"tidymodels",
"randomForest"
)
)
dataA_00 = read.csv("heart+disease/processed.cleveland.data")
dataA_00 = read.csv("heart+disease/processed.cleveland.data")
colnames(dataA_00) <- c(
"age",      # 3
"sex",      # 4
"cp",       # 9
"trestbps", # 10
"chol",     # 12
"fbs",      # 16
"restecg",  # 19
"thalach",  # 32
"exang",    # 38
"oldpeak",  # 40
"slope",    # 41
"ca",       # 44
"thal",     # 51
"num"       # 58 (target)
)
# Convert sex to factor
dataA_01 =
dataA_00 %>%
mutate(
sex =
plyr::mapvalues(
sex,
from = c(1, 0),
to = c("male", "female")
) %>%
factor(levels = c("female", "male"))
)
dataA_02 =
dataA_01 %>%
mutate(
num0 =
plyr::mapvalues(
x = num,
from = c(0, 1, 2, 3, 4),
to = c("0",
"1",
"1",
"1",
"1"
)
) %>%
factor(levels = c(1, 0)),
num =
plyr::mapvalues(
x = num,
from = c(0, 1, 2, 3, 4),
to = c("<50% diameter narrowing",
">50% diameter narrowing",
">50% diameter narrowing",
">50% diameter narrowing",
">50% diameter narrowing"
)
)
)
dataA_03 =
dataA_02 %>%
mutate(
cp = factor(cp, levels = c(1, 2, 3, 4))
)
dataA_04 =
dataA_03 %>%
mutate(
fbs = factor(fbs, levels = c(0, 1))
)
dataA_05 =
dataA_04 %>%
mutate(
restecg = factor(restecg, levels = c(2, 1, 0)),
ca = as.numeric(ca),
thal = factor(thal, levels = c("3.0", "6.0", "7.0"))
)
dataA = dataA_05
dataA_03 =
dataA_02 %>%
mutate(
cp = factor(cp, levels = c(1, 2, 3, 4))
)
output_df_final = read.csv("ROutput-RF tuning.csv")
output_df_final =
output_df_final %>%
mutate(
ntree_labels =
factor(
ntree_labels,
levels =
unique(ntree_labels)
)
)
ggplot(
output_df_final[sample(seq(1, dim(output_df_final)[1]), size = 10000), ],
aes(
x = mtry,
y = accuracy,
# color = ntree,
group = mtry
)
) +
# geom_boxplot(width = 0.1, outlier.shape = NA) +
# geom_violin(width = 0.25, aes(group = mtry)) +
geom_jitter(width = 1, alpha = 0.01, size = 15, shape = 21, fill = "grey", color = "grey") +
geom_smooth(method = "loess", se = FALSE, aes(group = ntree)) +
scale_x_continuous(
breaks = seq(0, 10)
) +
# scale_y_continuous(
#   limits = c(0.65, 0.1),
#   breaks = seq(0.65, 1, 0.02)
# ) +
labs(
x = "mtry",
y = "Accuracy",
title = "Accuracy vs. number of candidate predictors sampled at each split (mtry)"
) +
facet_wrap(~ntree_labels, nrow = 2) +
theme(
text = element_text(face = "bold", size = 20),
plot.title = element_text(hjust = 0.5),
plot.caption = element_text(hjust = 1),
axis.text.x = element_text(size = 8, angle = 45, hjust = 1),
panel.background = element_rect(fill = NA, color = "black"),
panel.border = element_rect(fill = NA, color = "black"),
strip.background = element_rect(fill = NA, color = NA),
strip.text = element_text(size = 12)
)
system("quarto render")
